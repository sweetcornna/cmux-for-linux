#!/usr/bin/env bash
# Open a folder in cmux, from a file manager's context menu.
#
#   cmux-open-here window <path>      new GTK window with a workspace there
#   cmux-open-here workspace <path>   new workspace in the running session
#
# Every file-manager integration this package ships calls this script, so the
# behaviour stays identical across Nautilus, Nemo, Dolphin and Caja.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: cmux-open-here <window|workspace> <directory>

  window     Open a GTK window on a new workspace rooted in <directory>.
  workspace  Create a workspace in the running cmux session, with its terminal
             in <directory>. Opens a GTK window when no viewer is running.

Environment:
  CMUX_SESSION            session name (default: main)
EOF
  exit 2
}

# File managers normally discard stderr. Report failures there for callers and
# also through whichever desktop notification or dialog helper is available.
fail() {
  local message="$1"
  printf '%s\n' "$message" >&2

  if command -v notify-send >/dev/null 2>&1 \
    && notify-send --app-name=cmux --icon=cmux "cmux" "$message" >/dev/null 2>&1; then
    exit 1
  fi
  if command -v zenity >/dev/null 2>&1 \
    && zenity --error --title=cmux --text="$message" >/dev/null 2>&1; then
    exit 1
  fi
  if command -v kdialog >/dev/null 2>&1 \
    && kdialog --title cmux --error "$message" >/dev/null 2>&1; then
    exit 1
  fi
  exit 1
}

[ $# -eq 2 ] || usage
mode="$1"
dir="$2"
session="${CMUX_SESSION:-main}"

[ -d "$dir" ] || fail "not a directory: $dir"

cmux_bin="$(command -v cmux || true)"
[ -n "$cmux_bin" ] || fail "cmux is not on PATH"

# Detach a process from a stable directory so the file manager's helper exits
# immediately and the child does not retain a transient file-manager directory.
# Workspace directories are set explicitly by create_workspace_here, not here.
spawn() {
  local target_dir="$1"
  shift
  ( cd "$target_dir" && setsid "$@" >/dev/null 2>&1 < /dev/null & )
}

# True when the session's control socket answers.
session_is_running() {
  "$cmux_bin" --session "$session" session current show >/dev/null 2>&1
}

start_session() {
  local polls=0 startup_log
  startup_log="$(mktemp -t cmux-open-here.XXXXXX)"

  # Keep the daemon's own diagnostics: a failure to start is usually specific
  # and actionable - a session whose lock is still held by a daemon whose socket
  # has gone, say - and reporting only a timeout hides the actual cause.
  ( cd / && setsid "$cmux_bin" --headless --session "$session" \
      >"$startup_log" 2>&1 < /dev/null & )

  while ! session_is_running; do
    if [ "$polls" -ge 50 ]; then
      local reason
      reason="$(head -c 400 "$startup_log" 2>/dev/null | tr '\n' ' ')"
      rm -f "$startup_log"
      if [ -n "$reason" ]; then
        fail "cmux session '$session' did not start: $reason"
      fi
      fail "cmux session '$session' did not start within 5 seconds"
    fi
    polls=$((polls + 1))
    sleep 0.1
  done
  rm -f "$startup_log"
}

# Direct cmux-gtk launches still auto-start a missing session. This helper
# establishes the session and directory-backed workspace first, so workspace
# placement never depends on the GUI or server process working directory.
launch_gtk() {
  local cmux_gtk_bin
  cmux_gtk_bin="$(command -v cmux-gtk || true)"
  [ -n "$cmux_gtk_bin" ] \
    || fail "cmux-gtk is not on PATH; reinstall the cmux package"

  spawn / "$cmux_gtk_bin" --session "$session"
}

# True when some client other than this CLI invocation is attached. A workspace
# created in a session nobody is looking at would be invisible, so the caller
# opens a window in that case.
session_has_viewer() {
  "$cmux_bin" --session "$session" client list --json 2>/dev/null \
    | grep -q '"self":false'
}

create_workspace_here() {
  local name workspace_created pane_created workspace_id pane_id terminal_id
  name="$(basename -- "$dir")"

  workspace_created="$("$cmux_bin" --session "$session" workspace create \
    --name "$name" --empty --json)" \
    || fail "could not create empty workspace in session '$session'"
  workspace_id="$(printf '%s' "$workspace_created" \
    | sed -n 's/.*"workspace_id":"\([^"]*\)".*/\1/p')"
  [ -n "$workspace_id" ] \
    || fail "cmux returned an incomplete empty workspace creation result"

  pane_created="$("$cmux_bin" --session "$session" pane create \
    --cwd "$dir" --json)" \
    || fail "could not create a pane rooted at '$dir'"
  pane_id="$(printf '%s' "$pane_created" \
    | sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p')"
  terminal_id="$(printf '%s' "$pane_created" \
    | sed -n 's/.*"terminal_id":"\([^"]*\)".*/\1/p')"
  [ -n "$pane_id" ] && [ -n "$terminal_id" ] \
    || fail "cmux returned an incomplete pane creation result"

  # Make the new workspace the session focus before GTK takes its initial
  # snapshot, so a newly activated window cannot reopen the previous focus.
  "$cmux_bin" --session "$session" workspace "$workspace_id" focus \
    >/dev/null 2>&1 \
    || fail "could not focus the new workspace in session '$session'"
}

open_window() {
  session_is_running || start_session
  create_workspace_here
  launch_gtk
}

open_workspace() {
  if ! session_is_running; then
    open_window
    return
  fi

  create_workspace_here

  session_has_viewer || launch_gtk
}

case "$mode" in
  window)    open_window ;;
  workspace) open_workspace ;;
  *)         usage ;;
esac
