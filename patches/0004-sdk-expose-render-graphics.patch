+                        "placements": [graphic_placement(41)]
+                    }
+                }
+            }),
+            None,
+            0,
+        )
+        .unwrap();
+        let TerminalAttachmentItem::Snapshot { render, .. } = item else {
+            panic!("expected snapshot");
+        };
+        let graphics = render.graphics.expect("graphics");
